{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "representation": {
          "title": "Representation",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mime Type"
        },
        "availability": {
          "default": "unknown",
          "title": "Availability",
          "type": "string"
        },
        "rights": {
          "anyOf": [
            {
              "$ref": "#/$defs/RightsStatement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        }
      },
      "required": [
        "id",
        "representation",
        "provider"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Author": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "identifiers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Identifiers",
          "type": "object"
        }
      },
      "required": [
        "id",
        "display_name"
      ],
      "title": "Author",
      "type": "object"
    },
    "IdentifierScheme": {
      "enum": [
        "doi",
        "pmid",
        "pmcid",
        "arxiv",
        "openalex",
        "semantic_scholar",
        "datacite",
        "dblp",
        "zbmath",
        "other"
      ],
      "title": "IdentifierScheme",
      "type": "string"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Identifier"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "provider_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Release"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "query_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Fingerprint"
        },
        "provider_request_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Fingerprint"
        },
        "response_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Sha256"
        },
        "software": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoftwareIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_record_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Record Sha256"
        }
      },
      "required": [
        "provider"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "ProviderReport": {
      "additionalProperties": true,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "result_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Count"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "provider",
        "status"
      ],
      "title": "ProviderReport",
      "type": "object"
    },
    "RetrievalHit": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "provider_rank": {
          "minimum": 1,
          "title": "Provider Rank",
          "type": "integer"
        },
        "provider_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Score"
        },
        "fused_rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fused Rank"
        },
        "work": {
          "anyOf": [
            {
              "$ref": "#/$defs/Work"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_record": {
          "additionalProperties": true,
          "title": "Raw Record",
          "type": "object"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenanceRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "provider",
        "provider_rank"
      ],
      "title": "RetrievalHit",
      "type": "object"
    },
    "RightsStatement": {
      "additionalProperties": false,
      "description": "Rights as observed, never inferred from access alone.",
      "properties": {
        "metadata_license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata License"
        },
        "content_license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content License"
        },
        "redistribution": {
          "default": "unknown",
          "title": "Redistribution",
          "type": "string"
        },
        "tdm": {
          "default": "unknown",
          "title": "Tdm",
          "type": "string"
        },
        "model_training": {
          "default": "unknown",
          "title": "Model Training",
          "type": "string"
        },
        "retention": {
          "default": "unknown",
          "title": "Retention",
          "type": "string"
        },
        "terms_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Url"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "title": "RightsStatement",
      "type": "object"
    },
    "SearchQuery": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "limit": {
          "default": 25,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "providers": {
          "items": {
            "type": "string"
          },
          "title": "Providers",
          "type": "array"
        },
        "filters": {
          "additionalProperties": true,
          "title": "Filters",
          "type": "object"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        }
      },
      "required": [
        "text"
      ],
      "title": "SearchQuery",
      "type": "object"
    },
    "SoftwareIdentity": {
      "additionalProperties": false,
      "properties": {
        "software": {
          "title": "Software",
          "type": "string"
        },
        "software_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Software Version"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        }
      },
      "required": [
        "software"
      ],
      "title": "SoftwareIdentity",
      "type": "object"
    },
    "Work": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "abstract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstract"
        },
        "publication_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Year"
        },
        "work_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Type"
        },
        "primary_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Language"
        },
        "identifiers": {
          "items": {
            "$ref": "#/$defs/WorkIdentifier"
          },
          "title": "Identifiers",
          "type": "array"
        },
        "authors": {
          "items": {
            "$ref": "#/$defs/Author"
          },
          "title": "Authors",
          "type": "array"
        },
        "assets": {
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Assets",
          "type": "array"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/ProvenanceRecord"
          },
          "title": "Provenance",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Work",
      "type": "object"
    },
    "WorkIdentifier": {
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "$ref": "#/$defs/IdentifierScheme"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "canonical_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Url"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "WorkIdentifier",
      "type": "object"
    },
    "WorkVersion": {
      "additionalProperties": false,
      "properties": {
        "version_label": {
          "default": "record",
          "title": "Version Label",
          "type": "string"
        },
        "version_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Date"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "raw_record": {
          "additionalProperties": true,
          "title": "Raw Record",
          "type": "object"
        }
      },
      "title": "WorkVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "query": {
      "$ref": "#/$defs/SearchQuery"
    },
    "hits": {
      "items": {
        "$ref": "#/$defs/RetrievalHit"
      },
      "title": "Hits",
      "type": "array"
    },
    "provider_reports": {
      "items": {
        "$ref": "#/$defs/ProviderReport"
      },
      "title": "Provider Reports",
      "type": "array"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "raw_envelope": {
      "additionalProperties": true,
      "title": "Raw Envelope",
      "type": "object"
    }
  },
  "required": [
    "query",
    "hits"
  ],
  "title": "SearchResponse",
  "type": "object"
}
