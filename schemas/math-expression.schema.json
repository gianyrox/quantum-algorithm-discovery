              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Identifier"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "provider_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
