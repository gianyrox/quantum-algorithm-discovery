    "MathNode": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/MathNode"
