        "content_license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content License"
        },
        "redistribution": {
          "default": "unknown",
          "title": "Redistribution",
          "type": "string"
        },
        "tdm": {
          "default": "unknown",
          "title": "Tdm",
          "type": "string"
        },
        "model_training": {
          "default": "unknown",
          "title": "Model Training",
          "type": "string"
        },
        "retention": {
          "default": "unknown",
          "title": "Retention",
          "type": "string"
