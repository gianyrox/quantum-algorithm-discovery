{
  "$defs": {
    "ProcessingStage": {
      "enum": [
        "identity_resolution",
        "integrity_check",
        "asset_discovery",
        "asset_acquisition",
        "document_parse",
        "problem_extraction",
        "mathematics",
        "structural_analysis"
      ],
      "title": "ProcessingStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "work_id": {
      "title": "Work Id",
      "type": "string"
    },
    "asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Id"
    },
    "stage": {
      "$ref": "#/$defs/ProcessingStage"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "priority": {
      "default": 0,
      "title": "Priority",
      "type": "integer"
    },
    "attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "max_attempts": {
      "default": 3,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "claimed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimed At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "id",
    "work_id",
    "stage",
    "status",
    "available_at"
  ],
  "title": "ProcessingJob",
  "type": "object"
}
