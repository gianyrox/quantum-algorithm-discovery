{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "representation": {
          "title": "Representation",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mime Type"
        },
        "availability": {
          "default": "unknown",
          "title": "Availability",
          "type": "string"
        },
        "rights": {
          "anyOf": [
            {
              "$ref": "#/$defs/RightsStatement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        }
      },
      "required": [
        "id",
        "representation",
        "provider"
      ],
      "title": "Asset",
      "type": "object"
    },
    "RightsStatement": {
      "additionalProperties": false,
      "description": "Rights as observed, never inferred from access alone.",
      "properties": {
        "metadata_license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata License"
        },
        "content_license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content License"
        },
        "redistribution": {
          "default": "unknown",
          "title": "Redistribution",
          "type": "string"
        },
        "tdm": {
          "default": "unknown",
          "title": "Tdm",
          "type": "string"
        },
        "model_training": {
          "default": "unknown",
          "title": "Model Training",
          "type": "string"
        },
        "retention": {
          "default": "unknown",
          "title": "Retention",
          "type": "string"
        },
        "terms_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Url"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "title": "RightsStatement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset": {
      "$ref": "#/$defs/Asset"
    },
    "score": {
      "title": "Score",
      "type": "number"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    }
  },
  "required": [
    "asset",
    "score"
  ],
  "title": "RankedAsset",
  "type": "object"
}
