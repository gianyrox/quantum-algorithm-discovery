{
  "$defs": {
    "CrossDomainRelation": {
      "enum": [
        "equivalent_formulation",
        "shared_mathematical_form",
        "shared_mechanism",
        "shared_function_different_mechanism",
        "historical_transmission",
        "independent_rediscovery",
        "analogy",
        "lexical_resemblance",
        "unresolved"
      ],
      "title": "CrossDomainRelation",
      "type": "string"
    },
    "MultiViewSimilarity": {
      "additionalProperties": false,
      "properties": {
        "problem_a_id": {
          "title": "Problem A Id",
          "type": "string"
        },
        "problem_b_id": {
          "title": "Problem B Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/SimilarityEvidence"
        },
        "aggregate_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Aggregate Score",
          "type": "number"
        },
        "structural_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Structural Score",
          "type": "number"
        },
        "independence_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Independence Score",
          "type": "number"
        },
        "explanation": {
          "items": {
            "type": "string"
          },
          "title": "Explanation",
          "type": "array"
        }
      },
      "required": [
        "problem_a_id",
        "problem_b_id",
        "evidence",
        "aggregate_score",
        "structural_score",
        "independence_score"
      ],
      "title": "MultiViewSimilarity",
      "type": "object"
    },
    "ProblemFamily": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "problem_ids": {
          "items": {
            "type": "string"
          },
          "title": "Problem Ids",
          "type": "array"
        },
        "shared_task_families": {
          "items": {
            "type": "string"
          },
          "title": "Shared Task Families",
          "type": "array"
        },
        "shared_mathematical_structures": {
          "items": {
            "type": "string"
          },
          "title": "Shared Mathematical Structures",
          "type": "array"
        },
        "shared_operations": {
          "items": {
            "type": "string"
          },
          "title": "Shared Operations",
          "type": "array"
        },
        "distinguishing_features": {
          "items": {
            "type": "string"
          },
          "title": "Distinguishing Features",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "status": {
          "default": "candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "ProblemFamily",
      "type": "object"
    },
    "RelationHypothesis": {
      "additionalProperties": false,
      "properties": {
        "problem_a_id": {
          "title": "Problem A Id",
          "type": "string"
        },
        "problem_b_id": {
          "title": "Problem B Id",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/CrossDomainRelation"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "requires_review": {
          "default": true,
          "title": "Requires Review",
          "type": "boolean"
        }
      },
      "required": [
        "problem_a_id",
        "problem_b_id",
        "relation",
        "confidence"
      ],
      "title": "RelationHypothesis",
      "type": "object"
    },
    "SimilarityEvidence": {
      "additionalProperties": false,
      "properties": {
        "lexical": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Lexical",
          "type": "number"
        },
        "semantic": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Semantic",
          "type": "number"
        },
        "task": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Task",
          "type": "number"
        },
        "mathematical": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Mathematical",
          "type": "number"
        },
        "operator": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Operator",
          "type": "number"
        },
        "constraint": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Constraint",
          "type": "number"
        },
        "topology": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Topology",
          "type": "number"
        },
        "stochastic": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Stochastic",
          "type": "number"
        },
        "complexity": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Complexity",
          "type": "number"
        },
        "method": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Method",
          "type": "number"
        },
        "citation_connectivity": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Citation Connectivity",
          "type": "number"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "SimilarityEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "problem_count": {
      "minimum": 0,
      "title": "Problem Count",
      "type": "integer"
    },
    "pair_count": {
      "minimum": 0,
      "title": "Pair Count",
      "type": "integer"
    },
    "similarities": {
      "items": {
        "$ref": "#/$defs/MultiViewSimilarity"
      },
      "title": "Similarities",
      "type": "array"
    },
    "families": {
      "items": {
        "$ref": "#/$defs/ProblemFamily"
      },
      "title": "Families",
      "type": "array"
    },
    "relation_hypotheses": {
      "items": {
        "$ref": "#/$defs/RelationHypothesis"
      },
      "title": "Relation Hypotheses",
      "type": "array"
    }
  },
  "required": [
    "problem_count",
    "pair_count"
  ],
  "title": "StructureDiscoveryResult",
  "type": "object"
}
