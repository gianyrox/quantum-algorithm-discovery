# Canonical relational store. SQLite is fine for one-machine development.
DISCOVERY_DATABASE_URL=sqlite:///data/scientific_discovery.db

# x402 research gateway. Paid calls still require a payment-capable deployment/client path.
# DISCOVERY_GATEWAY_URL=http://localhost:8091
DISCOVERY_GATEWAY_TIMEOUT=30

# Direct public-provider fallback/federation. Keep provider semantics separate from analysis.
DISCOVERY_DIRECT_PROVIDERS=openalex,crossref,europe_pmc,arxiv
# DISCOVERY_CONTACT_EMAIL=researcher@example.org
# OPENALEX_API_KEY=

DISCOVERY_ONTOLOGY_SEED=scientific_retrieval_ontology_v0_1
DISCOVERY_OBJECT_STORE=data/objects
